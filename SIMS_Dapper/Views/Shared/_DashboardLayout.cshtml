@using Microsoft.AspNetCore.Http

@{
    var role = Context.Session.GetString("RoleName");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SIMS ERP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f5f7fb;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            background: #1e293b;
            color: white;
            padding-top: 20px;
            overflow-y: auto;
        }

            .sidebar h3 {
                text-align: center;
                margin-bottom: 30px;
            }

            .sidebar a {
                display: block;
                color: white;
                text-decoration: none;
                padding: 12px 20px;
            }

                .sidebar a:hover {
                    background: #334155;
                }

        .main {
            margin-left: 250px;
            padding: 20px;
        }

        .topbar {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            margin-bottom: 20px;
        }

        .card-box {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <h3>SIMS ERP</h3>

        @if (role == "Admin")
        {
            <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
            <a asp-controller="Student" asp-action="Index">Students</a>
            <a asp-controller="Faculty" asp-action="Index">Faculty</a>
            <a asp-controller="Subject" asp-action="Index">Subjects</a>
            <a asp-controller="Department" asp-action="Index">Departments</a>
            <a asp-controller="Course" asp-action="Index">Courses</a>
            <a asp-controller="Branch" asp-action="Index">Branches</a>
            <a asp-controller="Section" asp-action="Index">Sections</a>
            <a asp-controller="Attendance" asp-action="AttendanceEntry">Attendance</a>
            <a href="#">Exams</a>
            <a href="#">Fees</a>
            <a href="#">Placements</a>
        }

        else if (role == "HOD")
        {
            <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
            <a asp-controller="Faculty" asp-action="Index">Faculty</a>
            <a asp-controller="Student" asp-action="Index">Students</a>
            <a asp-controller="Attendance" asp-action="AttendanceEntry">Attendance Reports</a>
            <a href="#">Internal Marks Approval</a>
        }

        else if (role == "Professor Incharge")
        {
            <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
            <a asp-controller="Student" asp-action="Index">Students</a>
            <a asp-controller="Attendance" asp-action="AttendanceEntry">Attendance</a>
        }

        else if (role == "Class Coordinator")
        {
            <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
            <a asp-controller="Student" asp-action="Index">Students</a>
            <a asp-controller="Attendance" asp-action="AttendanceEntry">Attendance</a>
        }

        else if (role == "Faculty")
        {
            <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
            <a asp-controller="Attendance" asp-action="AttendanceEntry">Attendance</a>
            <a href="#">Marks Upload</a>
            <a href="#">Exam Schedule</a>
        }

        else if (role == "Student")
        {
            <a asp-controller="Student" asp-action="Index">My Profile</a>
            <a href="#">My Attendance</a>
            <a href="#">My Results</a>
        }

        else if (role == "Parent")
        {
            <a href="#">Child Attendance</a>
            <a href="#">Child Results</a>
            <a href="#">Fee Status</a>
        }

        <a asp-controller="Account" asp-action="Logout">Logout</a>
    </div>

    <div class="main">

        <div class="topbar d-flex justify-content-between">
            <div>
                Welcome,
                <strong>@Context.Session.GetString("Username")</strong>
            </div>

            <div>
                Role:
                <strong>@Context.Session.GetString("RoleName")</strong>
            </div>
        </div>

        @RenderBody()

    </div>

    @RenderSection("Scripts", required: false)

</body>
</html>