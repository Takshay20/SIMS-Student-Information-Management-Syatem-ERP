@model IEnumerable<SIMS_Dapper.Models.Student>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between mb-3">
    <h2>Students</h2>

    <a asp-controller="Student"
       asp-action="Create"
       class="btn btn-primary">
        Add Student
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Enrollment</th>
            <th>Roll No</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Semester</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentName</td>
                <td>@item.EnrollmentNo</td>
                <td>@item.RollNo</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Semester</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.StudentId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.StudentId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>