@model SIMS_Dapper.Models.ViewModels.ExamViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Exam Schedule";
}

<h2 class="mb-4">Exam Schedule Management</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-action="SaveExam" method="post">

    <div class="row">

        <div class="col-md-4 mb-3">
            <label>Course</label>
            <select asp-for="Exam.CourseId"
                    asp-items="Model.Courses"
                    class="form-control">
                <option value="">Select Course</option>
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label>Branch</label>
            <select asp-for="Exam.BranchId"
                    asp-items="Model.Branches"
                    class="form-control">
                <option value="">Select Branch</option>
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label>Semester</label>
            <input asp-for="Exam.Semester"
                   class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label>Subject</label>
            <select asp-for="Exam.SubjectId"
                    asp-items="Model.Subjects"
                    class="form-control">
                <option value="">Select Subject</option>
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label>Exam Type</label>
            <input asp-for="Exam.ExamType"
                   class="form-control"
                   placeholder="Internal / External / Practical" />
        </div>

        <div class="col-md-4 mb-3">
            <label>Exam Date</label>
            <input asp-for="Exam.ExamDate"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label>Start Time</label>
            <input asp-for="Exam.StartTime"
                   type="time"
                   class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label>End Time</label>
            <input asp-for="Exam.EndTime"
                   type="time"
                   class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label>Venue</label>
            <input asp-for="Exam.Venue"
                   class="form-control" />
        </div>

    </div>

    <button class="btn btn-success mb-4">
        Create Exam
    </button>

</form>

<hr />

<h3>Scheduled Exams</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course</th>
            <th>Branch</th>
            <th>Semester</th>
            <th>Subject</th>
            <th>Type</th>
            <th>Date</th>
            <th>Venue</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Exams)
        {
            <tr>
                <td>@item.CourseName</td>
                <td>@item.BranchName</td>
                <td>@item.Semester</td>
                <td>@item.SubjectName</td>
                <td>@item.ExamType</td>
                <td>@item.ExamDate.ToShortDateString()</td>
                <td>@item.Venue</td>
            </tr>
        }
    </tbody>
</table>